# ---------------------------------------------------------------------------
# SQL Server lokal (host, bukan container)
#
# Seluruh variabel di blok ini HANYA dipakai bila backend dijalankan di dalam
# container (`docker compose --profile api up`). Untuk alur normal
# (`dotnet run`), connection string diambil dari appsettings.Development.json
# dan blok ini boleh diabaikan.
#
# Instance lokal harus mengaktifkan TCP/IP dan SQL Server Authentication;
# Windows Authentication tidak dapat dipakai dari container Linux.
# ---------------------------------------------------------------------------
DB_HOST=host.docker.internal
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=

DB_BUSINESS_NAME=SearchEngineBusinessDB
DB_IDENTITY_NAME=SearchEngineIdentityDB
DB_HANGFIRE_NAME=SearchEngineHangfireDB

ASPNETCORE_ENVIRONMENT=Docker

# Required. Use a long random value (at least 32 characters).
# Never commit a real secret.
JWT_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ---------------------------------------------------------------------------
# Elasticsearch & Kibana
# ---------------------------------------------------------------------------

# Versi image Elasticsearch dan Kibana. Keduanya WAJIB sama.
ELASTIC_VERSION=9.0.0

# Password superuser 'elastic'. Hanya dipakai container setup untuk bootstrap,
# bukan oleh backend. Required, minimal 6 karakter.
ELASTIC_PASSWORD=Admin123!

# Password built-in user 'kibana_system' yang dipakai Kibana untuk terhubung
# ke Elasticsearch. Required.
KIBANA_SYSTEM_PASSWORD=Admin123!

# Password user 'searchengine_app' yang dipakai backend. User ini hanya punya
# akses ke index berawalan ELASTIC_INDEX_PREFIX. Required.
ELASTIC_APP_PASSWORD=Admin123!

# Kunci enkripsi saved object Kibana. Required, minimal 32 karakter, dan harus
# tetap sama antar-restart.
KIBANA_ENCRYPTION_KEY=7f3c9a2e8d1b6f4a0c5e9b7d2a8f6c1e3d9b5a7c2f8e4d6a1b3c9e7f5d2a8b6

# Prefix seluruh index milik aplikasi. Menentukan juga cakupan hak akses
# user 'searchengine_app'.
ELASTIC_INDEX_PREFIX=searchengine

# Heap Elasticsearch. Naikkan ke -Xms2g -Xmx2g atau lebih saat volume data
# bertambah. Nilai Xms dan Xmx harus sama.
ES_JAVA_OPTS=-Xms1g -Xmx1g

# URL Kibana yang dibuka dari browser (bukan hostname internal docker).
KIBANA_PUBLIC_BASE_URL=http://localhost:5601
